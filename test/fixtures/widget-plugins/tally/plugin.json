{
  "manifestVersion": 1,
  "id": "tally",
  "name": "Tally",
  "description": "A test counter with a widget.",
  "version": "1.0.0",
  "apiVersion": 1,
  "entry": "src/index.ts",
  "permissions": { "network": [], "openExternal": [], "storage": false },
  "config": {},
  "tools": [
    {
      "name": "count",
      "description": "Reads the tally.",
      "effect": "read",
      "label": "Read the tally",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "name": "add",
      "description": "Adds to the tally.",
      "effect": "write",
      "label": "Add {amount} to the tally",
      "inputSchema": {
        "type": "object",
        "properties": { "amount": { "type": "integer", "minimum": 1, "maximum": 10 } },
        "required": ["amount"],
        "additionalProperties": false
      }
    }
  ],
  "widgets": [
    {
      "id": "counter",
      "title": "Tally",
      "description": "A running count with a button to add one. Useful when the user is counting something.",
      "widgetApi": 1,
      "entry": "widget/counter.ts",
      "inputSchema": {
        "type": "object",
        "properties": { "label": { "type": "string", "maxLength": 40 } },
        "additionalProperties": false
      },
      "tools": ["count", "add"],
      "height": { "initial": 96, "min": 64, "max": 200 },
      "refreshSeconds": 5
    }
  ]
}
